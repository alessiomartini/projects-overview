---
import Base from '../layouts/Base.astro';
import TokenSettings from '../islands/TokenSettings';
import { DATA_REPO } from '../config';
---

<Base title="Settings" active="impostazioni">
  <h1>Settings</h1>

  <section class="card">
    <h2>Edit mode</h2>
    <p class="muted">
      The site is public and read-only. To write ideas and notes or change status or priority you need a GitHub token that can write
      to the repo <code>{DATA_REPO}</code>. The token is stored <strong>only on this device</strong>.
    </p>
    <TokenSettings client:load />
  </section>

  <section class="card">
    <h2>How to create the token</h2>
    <ol>
      <li>
        Apri <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">GitHub → Fine-grained tokens → Generate new token</a>.
      </li>
      <li>Repository access: <em>Only select repositories</em> → <code>{DATA_REPO}</code>.</li>
      <li>Permissions → Repository permissions → <strong>Contents: Read and write</strong>.</li>
      <li>
        (Optional) also add the private project repos with read-only access: in edit mode you then see the details of their
        roadmaps too.
      </li>
      <li>Generate and copy the token, then paste it above. Repeat on each device (e.g. phone).</li>
    </ol>
  </section>

  <section class="card">
    <h2>On the phone</h2>
    <p class="muted">
      Open the site in the browser and use “Add to Home screen”: it opens straight on the Inbox to capture ideas on the fly.
    </p>
  </section>
</Base>

<style>
  section {
    margin-top: 16px;
  }
  ol {
    padding-left: 1.3em;
  }
  li {
    margin: 4px 0;
  }
</style>
