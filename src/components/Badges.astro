---
import type { Badge } from '../lib/projects';

interface Props {
  badges: Badge[];
  openNotes?: number;
}
const { badges, openNotes = 0 } = Astro.props;
---

{badges.includes('fermo') && <span class="badge warn" title="No commits for over a month">stalled</span>}
{badges.includes('completo') && <span class="badge good" title="Roadmap complete: mark as done?">roadmap complete</span>}
{openNotes > 0 && <span class="badge" title="Open notes">✎ {openNotes}</span>}
