---
import type { LogEntry } from '../lib/roadmap';
import { formatDate, inlineMarkdown } from '../lib/format';

interface Props {
  log: LogEntry[];
  limit?: number;
}
const { log, limit = 20 } = Astro.props;
const shown = log.slice(0, limit);
---

<ol class="timeline">
  {
    shown.map((entry) => (
      <li>
        <time datetime={entry.date}>{formatDate(entry.date)}</time>
        <p set:html={inlineMarkdown(entry.text)} />
      </li>
    ))
  }
</ol>
{log.length > limit && <p class="muted small">…e altre {log.length - limit} voci nel ROADMAP.md.</p>}

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--border);
  }
  li {
    position: relative;
    padding: 0 0 14px 16px;
  }
  li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--surface);
  }
  time {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }
  p {
    margin: 2px 0 0;
  }
</style>
