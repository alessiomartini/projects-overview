---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ReorderBoard from '../islands/ReorderBoard';
import { getProjects, generatedAt } from '../lib/data';
import { KINDS, KIND_LABEL, SECTIONS, SECTION_LABEL, STATUS_LABEL } from '../lib/projects';
import { relativeDate } from '../lib/format';

const projects = await getProjects();
const groups = Object.fromEntries(SECTIONS.map((s) => [s, projects.filter((p) => p.section === s)]));
const active = projects.filter((p) => p.rank > 0);
const usedKinds = KINDS.filter((k) => projects.some((p) => p.kind === k));
---

<Base active="home">
  <div class="head">
    <div>
      <h1>I miei progetti</h1>
      <p class="legend small">
        {usedKinds.map((k) => <span data-kind={k}><i />{KIND_LABEL[k]}</span>)}
      </p>
    </div>
    <div class="edit-only">
      <ReorderBoard client:idle items={active.map((p) => ({ slug: p.slug, title: p.title, status: p.status }))} statusLabels={STATUS_LABEL} />
    </div>
  </div>

  {
    SECTIONS.map((s) =>
      groups[s].length === 0 ? null : s === 'archiviati' ? (
        <details class="group">
          <summary>
            <h2>
              {SECTION_LABEL[s]} <span class="count">{groups[s].length}</span>
            </h2>
          </summary>
          <div class="grid">
            {groups[s].map((p) => <ProjectCard project={p} />)}
          </div>
        </details>
      ) : (
        <section class="group">
          <h2>
            {SECTION_LABEL[s]} <span class="count">{groups[s].length}</span>
          </h2>
          <div class="grid">
            {groups[s].map((p) => <ProjectCard project={p} />)}
          </div>
        </section>
      ),
    )
  }

  {projects.length === 0 && <p class="muted">Nessun progetto ancora: aggiungi un file in <code>data/projects/</code> o trasforma un'idea dall'Inbox.</p>}

  {generatedAt && <p class="muted small updated">Dati dai repo aggiornati {relativeDate(generatedAt)} ({new Date(generatedAt).toLocaleString('it-IT', { timeZone: 'Europe/Rome' })}).</p>}
</Base>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .head > .edit-only {
    flex: 0 1 520px;
    text-align: right;
    min-width: 0;
    max-width: 100%;
  }
  .legend {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--k);
    font-weight: 600;
  }
  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--k);
  }
  .group {
    margin-top: 26px;
  }
  .group h2 {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .count {
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--surface-2);
    border-radius: 999px;
    padding: 1px 8px;
  }
  details > summary {
    cursor: pointer;
    list-style: none;
    margin-bottom: 0.5em;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary h2::before {
    content: '▸';
    color: var(--muted);
    transition: transform 0.15s;
  }
  details[open] > summary h2::before {
    transform: rotate(90deg);
  }
  .updated {
    margin-top: 40px;
  }
  @media (max-width: 600px) {
    .head > .edit-only {
      text-align: left;
    }
  }
</style>
