---
import type { ProjectView } from '../lib/projects';
import { KIND_LABEL } from '../lib/projects';
import { url } from '../lib/paths';
import { inlineMarkdown, relativeDate } from '../lib/format';
import ProgressRing from './ProgressRing.astro';
import Badges from './Badges.astro';

interface Props {
  project: ProjectView;
}
const { project: p } = Astro.props;
const MAX = 3;
---

<article class="card project-card" data-kind={p.kind}>
  <div class="top">
    <ProgressRing progress={p.progress} />
    <div class="title">
      <h3><a href={url(`progetti/${p.slug}/`)}>{p.title}</a></h3>
      <div class="row small meta">
        {p.kind && <span class="kind">{KIND_LABEL[p.kind]}</span>}
        {p.status === 'idea' && <span class="badge idea">idea</span>}
        <Badges badges={p.badges} openNotes={p.openNotes} />
        {p.lastActivity && <span class="muted" title={p.lastActivity}>{relativeDate(p.lastActivity)}</span>}
      </div>
    </div>
  </div>
  {
    p.doing.length > 0 && (
      <div class="list small">
        <span class="lbl">In corso</span>
        <ul>
          {p.doing.slice(0, MAX).map((t) => <li set:html={inlineMarkdown(t)} />)}
          {p.doing.length > MAX && <li class="muted">+{p.doing.length - MAX} altre</li>}
        </ul>
      </div>
    )
  }
  {
    p.todo.length > 0 && (
      <div class="list small">
        <span class="lbl">Da fare</span>
        <ul>
          {p.todo.slice(0, MAX).map((t) => <li set:html={inlineMarkdown(t)} />)}
          {p.todo.length > MAX && <li class="muted">+{p.todo.length - MAX} altre</li>}
        </ul>
      </div>
    )
  }
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-left: 4px solid var(--k, var(--border));
  }
  .top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .title {
    min-width: 0;
    flex: 1;
  }
  .title h3 {
    margin: 0 0 2px;
    font-size: 1.05rem;
  }
  .title h3 a {
    color: var(--text);
  }
  .meta {
    gap: 6px;
  }
  .kind {
    color: var(--k);
    font-weight: 600;
  }
  .idea {
    background: var(--s-idea);
    color: #fff;
    border-color: transparent;
  }
  .lbl {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  ul {
    margin: 2px 0 0;
    padding-left: 18px;
  }
  li {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
