---
import Base from '../layouts/Base.astro';
import InboxList from '../islands/InboxList';
import { getIdeas } from '../lib/data';
import { url } from '../lib/paths';

const ideas = await getIdeas();
---

<Base title="Inbox" active="inbox">
  <h1>Inbox</h1>
  <p class="muted">Ideas jotted down on the fly. When one convinces you, turn it into a project.</p>
  <p class="view-only card small">
    To write ideas from here, turn on <a href={url('impostazioni/')}>edit mode</a>.
  </p>
  <InboxList client:load initial={ideas.map((i) => ({ path: i.path, date: i.date.toISOString(), text: i.text }))} />
</Base>

<style>
  .view-only {
    margin-bottom: 18px;
  }
  :global(.ideas) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  :global(.idea-text) {
    white-space: pre-wrap;
    margin: 0 0 10px;
  }
</style>
